# build output
bin/
obj/
*.pdb

# release binaries (rebuild with dotnet publish / ISCC, see README)
artifacts/**/*.exe
artifacts/**/*.sha256

# editor
.vs/
*.user

# Trailer render intermediates (editable assets are included in the source ZIP)
/artifacts/trailer/assets/
/artifacts/trailer/audio/
/artifacts/trailer/qa/
/artifacts/trailer/video-silent.mp4
/artifacts/trailer/source/__pycache__/

# 55 s trailer project: keep editable source, skip renders, QA stills and generated audio
/artifacts/trailer-55s/qa/
/artifacts/trailer-55s/*.mp4
/artifacts/trailer-55s/*.log
/artifacts/trailer-55s/render.done
/artifacts/trailer-55s/capture-check.png
/artifacts/trailer-55s/project/public/audio/*.wav
